# Python cache and local environments
__pycache__/
*.py[cod]
.venv/
venv/

# Temporary extraction/test output
_frame_extract_test*/
*.tmp

# Training outputs and large generated artifacts
runs/
weights/
*.pt
*.onnx
*.engine

# Raw source videos are kept locally and documented separately.
video/
external/coco2017/

# Temporary threshold sweeps; keep the selected clean evaluation instead.
results/test_sweep_*/
results/val_evaluation_*/
results/test_evaluation/

# Rebuilt by convert_isat_to_yolo.py from the tracked source images.
dataset/yolo/images/
dataset/yolo/**/*.cache

# Keep CSV/JSON summaries in Git; select only representative error images.
results/test_evaluation_clean/errors/
results/v2_test_evaluation/errors/
results/coco_external_test/

# Track only the selected deployment checkpoint; keep other generated weights ignored.
!weights/
weights/*
!weights/best.pt
!weights/README.md

# Report build and visual-check artifacts
report/*.aux
report/*.log
report/*.out
report/tmp/
report/_*.png
report/notes.md
report/task_plan.md

# Local third-party installers
vmware_setup/
